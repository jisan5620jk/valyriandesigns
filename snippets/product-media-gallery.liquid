{% comment %}
  Renders a product media gallery. Should be used with 'media-gallery.js'
  Also see 'product-media-modal'

  Accepts:
  - product: {Object} Product liquid object
  - variant_images: {Array} Product images associated with a variant
  - limit: {Number} (optional) When passed, limits the number of media items to render

  Usage:
  {% render 'product-media-gallery' %}

  Variant media system:
  - All variant combination images are rendered in the DOM on page load
  - Non-active variants are hidden with .vms-hidden (display:none !important)
  - Active variant's images all have data-media-group so Dawn's gallery
    initialises them correctly (sizing, slider, modal, etc.)
  - Our JS (l-variant-media) ONLY handles variant switching:
      • removes .vms-hidden from new variant's items
      • adds .vms-hidden to old variant's items
      • resets is-active on gallery items and thumbnail highlight
  - Dawn's own l-product-media handles everything else:
    thumbnail clicks, active image display, modal, etc.
{% endcomment %}

{%- liquid
  assign current_variant       = product.selected_or_first_available_variant
  assign variant_key           = current_variant.options | join: ', '
  assign variant_key_no_space  = current_variant.options | join: ','

  assign media_mappings        = product.metafields.custom.media_mappings.value
  assign has_metafield_media   = false
  if media_mappings and media_mappings.size > 0
    assign has_metafield_media = true
  endif

  # How many images does the active variant have? (for thumbnail sizing math)
  assign active_variant_count = 0
  if has_metafield_media
    for mapping in media_mappings
      assign mkey = mapping.variant_value.value
      if mkey == variant_key or mkey == variant_key_no_space
        assign active_variant_count = active_variant_count | plus: 1
      endif
    endfor
  endif
  if active_variant_count == 0
    assign active_variant_count = product.media.size
  endif
  # Standard Dawn layout variables
  assign media_count = product.media.size
  if section.settings.hide_variants and variant_images.size == product.media.size
    assign single_media_visible = true
  endif
  if limit == 1
    assign single_media_visible = true
  endif
  if section.settings.hide_variants and media_count > 1 and variant_images.size > 0
    assign media_count = media_count | minus: variant_images.size | plus: 1
  endif
  if media_count == 1 or single_media_visible
    assign single_media_visible_mobile = true
  endif
  if media_count == 0 or single_media_visible_mobile or section.settings.mobile_thumbnails == 'show' or section.settings.mobile_thumbnails == 'columns' and media_count < 3
    assign hide_mobile_slider = true
  endif
  if section.settings.media_size == 'large'
    assign media_width = 0.65
  elsif section.settings.media_size == 'medium'
    assign media_width = 0.55
  elsif section.settings.media_size == 'small'
    assign media_width = 0.45
  endif
-%}
<!-- DEBUG active_variant_count: {{ active_variant_count }} | variant_key: {{ variant_key }} -->

<script type="application/json" id="MediaJson-{{ section.id }}">
  {{ product.media | json }}
</script>

<style>
  /*
   * .vms-hidden hides items belonging to non-active variant combinations.
   * !important overrides any Dawn is-active or display rules.
   * Our JS toggles this class on variant change.
   * Dawn's own JS handles everything else (active image, slider, modal).
   */
  .vms-hidden {
    display: none !important;
  }
</style>

<l-product-media
  id="GalleryViewer-{{ section.id }}"
  data-section="{{ section.id }}"
  role="region"
  aria-label="{{ 'products.product.media.gallery_viewer' | t }}"
>
  <div id="GalleryStatus-{{ section.id }}" class="visually-hidden" role="status"></div>

  {% comment %}─────────────────────────────────────────────────────────────────
    MAIN GALLERY
    Each image is a standard Dawn product__media-item WITH data-media-group
    so Dawn's l-product-media initialises each item correctly (sizing, slider).

    Non-active variant items get class="vms-hidden" (display:none !important).
    Active variant items are fully visible; the first one gets is-active so
    Dawn shows it as the hero image on page load.

    data-variant-combo lets our JS identify which items belong to which variant.
  ─────────────────────────────────────────────────────────────────{% endcomment %}
  <div>
    <a class="skip-to-content-link button visually-hidden quick-add-hidden" href="#ProductInfo-{{ section.id }}">
      {{ 'accessibility.skip_to_product_info' | t }}
    </a>

    <div class="product__media-list list-unstyled" role="list">

      {%- if has_metafield_media -%}

        <l-variant-media
          id="LVariantMedia-{{ section.id }}"
          data-section="{{ section.id }}"
          data-variant-key="{{ variant_key }}"
          style="display:contents"
        >
          {%- assign vms_first_active_done = false -%}

          {%- for mapping in media_mappings -%}
            {%- assign combo   = mapping.variant_value.value -%}
            {%- assign pos     = mapping.image_position.value -%}
            {%- if pos == blank -%}{%- assign pos = mapping.media_position.value -%}{%- endif -%}
            {%- assign pos_int = pos | plus: 0 -%}

            {%- for media in product.media -%}
              {%- if media.position == pos_int -%}

                {%- assign is_current_variant = false -%}
                {%- if combo == variant_key or combo == variant_key_no_space -%}
                  {%- assign is_current_variant = true -%}
                {%- endif -%}

                {%- comment -%}
                  is-active on the first item of the current variant tells Dawn
                  to display it as the hero image. Dawn manages is-active for
                  subsequent thumbnail clicks within the active variant set.
                  All other active-variant items start without is-active; Dawn
                  will add/remove is-active as the user clicks thumbnails.
                {%- endcomment -%}
                {%- assign is_hero = false -%}
                {%- if is_current_variant and vms_first_active_done == false -%}
                  {%- assign is_hero = true -%}
                  {%- assign vms_first_active_done = true -%}
                {%- endif -%}

                <div
                  class="product__media-item{% if is_hero %} is-active{% endif %}{% unless is_current_variant %} vms-hidden{% endunless %}"
                  data-media-group
                  data-section="{{ section.id }}"
                  data-variant-combo="{{ combo }}"
                  data-media-id="{{ media.id }}"
                >
                  {% render 'product-thumbnail',
                    media: media,
                    media_count: active_variant_count,
                    position: forloop.index,
                    desktop_layout: section.settings.gallery_layout,
                    mobile_layout: section.settings.mobile_thumbnails,
                    loop: section.settings.enable_video_looping,
                    modal_id: section.id,
                    xr_button: true,
                    media_width: media_width,
                    media_fit: section.settings.media_fit,
                    constrain_to_viewport: section.settings.constrain_to_viewport,
                    lazy_load: false,
                    fetchpriority: 'high'
                  %}
                </div>

                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}

        </l-variant-media>

      {%- else -%}

        {%- comment -%}── FALLBACK: product has no media_mappings metafield ──{%- endcomment -%}
        {%- for media in product.media -%}
          <div
            class="product__media-item{% if forloop.first %} is-active{% endif %}"
            data-media-group
            data-section="{{ section.id }}"
          >
            {% render 'product-thumbnail',
              media: media,
              media_count: media_count,
              position: forloop.index,
              desktop_layout: section.settings.gallery_layout,
              mobile_layout: section.settings.mobile_thumbnails,
              loop: section.settings.enable_video_looping,
              modal_id: section.id,
              xr_button: true,
              media_width: media_width,
              media_fit: section.settings.media_fit,
              constrain_to_viewport: section.settings.constrain_to_viewport,
              lazy_load: false,
              fetchpriority: 'high'
            %}
          </div>
        {%- endfor -%}

      {%- endif -%}

    </div>
  </div>

  {% comment %}─────────────────────────────────────────────────────────────────
    VIDEO POPUP SECTION
  ─────────────────────────────────────────────────────────────────{% endcomment %}
  {%- for block in section.blocks -%}
    {%- if block.type == 'product_video' -%}

      {%- assign video_show_for_variant = false -%}
      {%- if block.settings.enable_stainless_steel   and current_variant.options contains 'Stainless Steel'    -%}{%- assign video_show_for_variant = true -%}{%- endif -%}
      {%- if block.settings.enable_black_powder       and current_variant.options contains 'Black Powder Coated'-%}{%- assign video_show_for_variant = true -%}{%- endif -%}
      {%- if block.settings.enable_corten_steel       and current_variant.options contains 'Corten Steel'       -%}{%- assign video_show_for_variant = true -%}{%- endif -%}
      {%- if block.settings.enable_coated_steel_black and current_variant.options contains 'Coated Steel Black' -%}{%- assign video_show_for_variant = true -%}{%- endif -%}

      {%- for i in (1..3) -%}
        {%- assign alt_key    = 'image_alt_text'        -%}
        {%- assign poster_key = 'product_video_poster'  -%}
        {%- assign video_key  = 'product_video_desktop' -%}
        {%- if i == 2 -%}
          {%- assign alt_key    = 'image_alt_text2'        -%}
          {%- assign poster_key = 'product_video_poster2'  -%}
          {%- assign video_key  = 'product_video_desktop2' -%}
        {%- elsif i == 3 -%}
          {%- assign alt_key    = 'image_alt_text3'        -%}
          {%- assign poster_key = 'product_video_poster3'  -%}
          {%- assign video_key  = 'product_video_desktop3' -%}
        {%- endif -%}
        {%- assign alt_value    = block.settings[alt_key]    -%}
        {%- assign poster_value = block.settings[poster_key] -%}
        {%- assign video_value  = block.settings[video_key]  -%}
        {%- if alt_value != blank and video_value != blank -%}
          <div class="video-container" style="display:none;">
            <video
              id="product-video-{{ block.id }}-{{ i }}"
              class="product-video"
              data-id="{{ alt_value }}"
              width="100%" height="100%"
              playsinline loop muted autoplay preload="auto"
              poster="{{ poster_value | img_url: 'master' }}"
            >
              <source src="{{ video_value.sources[1].url }}" type="video/mp4">
            </video>
            <div class="play-icon">
              <svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 512 512" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg">
                <path d="M128 104.3v303.4c0 6.4 6.5 10.4 11.7 7.2l240.5-151.7c5.1-3.2 5.1-11.1 0-14.3L139.7 97.2c-5.2-3.3-11.7.7-11.7 7.1z"></path>
              </svg>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <script>
        window.productVideoOptions = {
          stainlessSteel:   {{ block.settings.enable_stainless_steel   | json }},
          blackPowder:      {{ block.settings.enable_black_powder      | json }},
          cortenSteel:      {{ block.settings.enable_corten_steel      | json }},
          coatedSteelBlack: {{ block.settings.enable_coated_steel_black | json }}
        };
        (function () {
          var btn = document.getElementById('openPopupBtn');
          if (!btn) return;
          if ({{ video_show_for_variant | json }}) { btn.classList.add('show'); } else { btn.classList.remove('show'); }
        })();
      </script>

    {%- endif -%}
  {%- endfor -%}

  {% comment %}─────────────────────────────────────────────────────────────────
    THUMBNAILS
    Each thumbnail gets its own thumbnail-list__item div (Dawn requirement —
    it treats each wrapper as one gallery slot; multiple buttons in one
    wrapper = only the first is ever shown).

    Non-active variant thumbnails get vms-hidden.
    Active variant thumbnails are all visible; first one is highlighted
    with is-active (the selected border/state).

    data-variant-combo lets our JS identify which thumbnails to show/hide.
    data-media-id on the button is what Dawn uses to wire thumbnail → gallery item.
  ─────────────────────────────────────────────────────────────────{% endcomment %}
  {%- if first_3d_model -%}
    <button
      class="button button--full-width product__xr-button"
      type="button"
      aria-label="{{ 'products.product.xr_button_label' | t }}"
      data-shopify-xr
      data-shopify-model3d-id="{{ first_3d_model.id }}"
      data-shopify-title="{{ product.title | escape }}"
      data-shopify-xr-hidden
    >
      {% render 'icon-3d-model' %}
      {{ 'products.product.xr_button' | t }}
    </button>
  {%- endif -%}

  {%- liquid
    assign is_not_limited_to_single_item = false
    if limit == null or limit > 1
      assign is_not_limited_to_single_item = true
    endif
  -%}

  {%- if is_not_limited_to_single_item
    and active_variant_count > 1
    and section.settings.gallery_layout contains 'thumbnail'
    or section.settings.mobile_thumbnails == 'show'
  -%}
    <div class="thumbnail-list" id="ThumbnailList-{{ section.id }}">
      {%- capture sizes -%}
        (min-width: {{ settings.page_width }}px) calc(({{ settings.page_width | minus: 100 | times: media_width | round }} - 4rem) / 4),
        (min-width: 990px) calc(({{ media_width | times: 100 }}vw - 4rem) / 4),
        (min-width: 750px) calc((100vw - 15rem) / 8),
        calc((100vw - 8rem) / 3)
      {%- endcapture -%}

      {%- if has_metafield_media -%}

        {%- assign vms_first_thumb_done = false -%}

        {%- for mapping in media_mappings -%}
          {%- assign combo   = mapping.variant_value.value -%}
          {%- assign pos     = mapping.image_position.value -%}
          {%- if pos == blank -%}{%- assign pos = mapping.media_position.value -%}{%- endif -%}
          {%- assign pos_int = pos | plus: 0 -%}

          {%- for media in product.media -%}
            {%- if media.position == pos_int -%}

              {%- assign thumb_is_current = false -%}
              {%- if combo == variant_key or combo == variant_key_no_space -%}
                {%- assign thumb_is_current = true -%}
              {%- endif -%}

              {%- assign thumb_is_selected = false -%}
              {%- if thumb_is_current and vms_first_thumb_done == false -%}
                {%- assign thumb_is_selected = true -%}
                {%- assign vms_first_thumb_done = true -%}
              {%- endif -%}

              {%- assign media_index  = forloop.index -%}
              {%- assign thumbnail_id = 'Thumbnail-' | append: section.id | append: '-' | append: media.id -%}

              <div
                class="thumbnail-list__item{% unless thumb_is_current %} vms-hidden{% endunless %}"
                data-variant-combo="{{ combo }}"
                data-media-id="{{ media.id }}"
              >
                <button
                  class="thumbnail global-media-settings global-media-settings--no-shadow{% if thumb_is_selected %} is-active{% endif %}"
                  aria-label="{%- if media.media_type == 'image' -%}{{ 'products.product.media.load_image' | t: index: media_index }}{%- elsif media.media_type == 'model' -%}{{ 'products.product.media.load_model' | t: index: media_index }}{%- elsif media.media_type == 'video' or media.media_type == 'external_video' -%}{{ 'products.product.media.load_video' | t: index: media_index }}{%- endif -%}"
                  aria-controls="GalleryViewer-{{ section.id }}"
                  aria-describedby="{{ thumbnail_id }}"
                  data-media-id="{{ media.id }}"
                >
                  {{
                    media.preview_image
                    | image_url: width: 416
                    | image_tag:
                      loading: 'lazy',
                      sizes: sizes,
                      widths: '54, 74, 104, 162, 208, 324, 416',
                      id: thumbnail_id,
                      alt: media.preview_image.alt | default: product.title
                    | escape
                  }}
                </button>
              </div>

              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}

      {%- else -%}

        {%- comment -%}── FALLBACK thumbnails ──{%- endcomment -%}
        {%- for media in product.media -%}
          {%- assign media_index  = forloop.index -%}
          {%- assign thumbnail_id = 'Thumbnail-' | append: section.id | append: '-' | append: media.id -%}
          <div
            class="thumbnail-list__item{% if forloop.first %} is-active{% endif %}"
            id="{{ section.id }}-thumbnail-{{ forloop.index }}"
            data-thumbnail-group
          >
            <button
              class="thumbnail global-media-settings global-media-settings--no-shadow{% if forloop.first %} is-active{% endif %}"
              aria-label="{%- if media.media_type == 'image' -%}{{ 'products.product.media.load_image' | t: index: media_index }}{%- elsif media.media_type == 'model' -%}{{ 'products.product.media.load_model' | t: index: media_index }}{%- elsif media.media_type == 'video' or media.media_type == 'external_video' -%}{{ 'products.product.media.load_video' | t: index: media_index }}{%- endif -%}"
              aria-controls="GalleryViewer-{{ section.id }}"
              aria-describedby="{{ thumbnail_id }}"
              data-media-id="{{ media.id }}"
            >
              {{
                media.preview_image
                | image_url: width: 416
                | image_tag:
                  loading: 'lazy',
                  sizes: sizes,
                  widths: '54, 74, 104, 162, 208, 324, 416',
                  id: thumbnail_id,
                  alt: media.preview_image.alt | default: product.title
                | escape
              }}
            </button>
          </div>
        {%- endfor -%}

      {%- endif -%}

    </div>
  {%- endif -%}

</l-product-media>
