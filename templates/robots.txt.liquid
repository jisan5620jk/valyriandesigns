{%- comment -%}
# Caution! Please read https://help.shopify.com/en/manual/promoting-marketing/seo/editing-robots-txt before proceeding to make changes to this file.
# Optimized for SEO and compatibility with tools like SEMrush
{% endcomment %}
{% for group in robots.default_groups %}
  {{- group.user_agent -}}

  {% for rule in group.rules %}
    {{- rule -}}
  {% endfor %}

  # Ensure essential resources are accessible
  Allow: /assets/
  Allow: /scripts/
  Allow: /images/
  Allow: /collections/
  Allow: /products/
  Allow: /blogs/
  Allow: /pages/

  # Prioritize sitemap for crawling
  Sitemap: https://valyriandesigns.com/sitemap.xml

  {%- if group.sitemap != blank -%}
    {{ group.sitemap }}
  {%- endif -%}
{% endfor %}
