{{ 'lta-sections-media-with-contents.css' | asset_url | stylesheet_tag }}
{{ 'lta-sections-founder.css' | asset_url | stylesheet_tag }}

{%- if section.settings.video.id != null or section.settings.video_url.id != null -%}
  {{ 'video-section.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- style -%}
  	#shopify-section-{{ section.id }} {
  	  --page-width: {% if section.settings.show_full_width %}100%{% else %}{{ section.settings.page_width }}px{% endif %};
  	  --l-content-container-bg: {{ section.settings.content_container_bg }};
  	  --grid-desktop-vertical-spacing: {{ section.settings.spacing_grid_vertical }}px;
  		--grid-desktop-horizontal-spacing: {{ section.settings.spacing_grid_horizontal }}px;
  		--grid-mobile-vertical-spacing: {{ section.settings.spacing_grid_vertical | divided_by: 2 }}px;
  		--grid-mobile-horizontal-spacing: {{ section.settings.spacing_grid_horizontal | divided_by: 2 }}px;
  	  background-color: {{ section.settings.background_color }};
  	  padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
  	  padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  	}

  	@media screen and (min-width: 750px) {
  	  #shopify-section-{{ section.id }} {
  	    padding-top: {{ section.settings.padding_top }}px;
  	    padding-bottom: {{ section.settings.padding_bottom }}px;
  	  }
  	}

  .l-mwc__content--mobile-center>* {
      text-align: left !important;
  	align-self: start !important;
  }

  a.l-button--dynamic.l-button--primary.l-button--mobile-full.button {
    overflow: hidden;
    transition: all 0.3s;
    position: relative;
    z-index: 1;
  }
  a.l-button--dynamic.l-button--primary.l-button--mobile-full.button:hover {
    color: white;
    outline: none;
  }
  a.l-button--dynamic.l-button--primary.l-button--mobile-full.button img {
    transition: all 0.3s;
  }
  a.l-button--dynamic.l-button--primary.l-button--mobile-full.button:hover img {
    filter: brightness(0) invert(1);
  }
  a.l-button--dynamic.l-button--primary.l-button--mobile-full.button:before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 0;
    height: 100%;
    background: black;
    z-index: -1;
    transition: all 0.3s;
  }
  a.l-button--dynamic.l-button--primary.l-button--mobile-full.button:hover:before {
    width: 100%;
    left: 0;
  }

  @media screen and (min-width: 992px) and (max-width: 1280px) {
    a.l-button--dynamic.l-button--primary.l-button--mobile-full.button {
      gap: 6px !important;
      padding: 10px 10px !important;
      font-size: 11px !important;
    }
  }


  @media screen and (max-width: 380px) {
  a.l-button--dynamic.l-button--primary.l-button--mobile-full.button {
      gap: 4px !important;
      padding: 6px 10px !important;
      font-size: 11px !important;
  }

  }


  	{% for block in section.blocks %}

  	#{{ section.id }}-{{ block.id }} {
  	  {% if block.settings.text_color %}
  	  --l-color: {{ block.settings.text_color }};
  	  {% endif %}
  	  --l-mt: {{ block.settings.padding_top }}px;
  	  --l-mb: {{ block.settings.padding_bottom }}px;
  	  {%- case block.type -%}
  	    {%- when 'text' -%}
  	      --l-link-color: {{ block.settings.link_color }};
  	    {% when 'buttons' %}
  	      --l-buttons-gap: {{ block.settings.buttons_gap }}px;
  	      {% if block.settings.first_button_label %}
  	      .l-button--primary {
  	        --color-button: {{ block.settings.first_button_bg.red }},{{ block.settings.first_button_bg.green }},{{ block.settings.first_button_bg.blue }};
  	        --color-button-text: {{ block.settings.first_button_text.red }},{{ block.settings.first_button_text.green }},{{ block.settings.first_button_text.blue }};
  	        --button-font-weight: {{ block.settings.first_font_weight }};
  	        --button-border-width: {{ block.settings.first_button_border_width }}px;
  	        --button-border-radius: {{ block.settings.first_button_border_radius }}px;
  	        --button-border-color: {{ block.settings.first_button_border.red }},{{ block.settings.first_button_border.green }},{{ block.settings.first_button_border.blue }};
  	      }
  	      {% endif %}
  	      {% if block.settings.second_button_label %}
  	      .l-button--secondary {
  	        --color-button: {{ block.settings.second_button_bg.red }},{{ block.settings.second_button_bg.green }},{{ block.settings.second_button_bg.blue }};
  	        --color-button-text: {{ block.settings.second_button_text.red }},{{ block.settings.second_button_text.green }},{{ block.settings.second_button_text.blue }};
  	        --button-font-weight: {{ block.settings.second_font_weight }};
  	        --button-border-width:{{ block.settings.second_button_border_width }}px;
  	        --button-border-radius: {{ block.settings.second_button_border_radius }}px;
  	        --button-border-color: {{ block.settings.second_button_border.red }},{{ block.settings.second_button_border.green }},{{ block.settings.second_button_border.blue }};
  	      }
  	      {% endif %}
  	    {% when 'icon' %}
  	      --l-width: {{ block.settings.icon_width }}px;
  	    {% when 'count_down' %}
  	      --l-number-bg: {{ block.settings.number_bg }};
  	      --l-number-color: {{ block.settings.number_color }};
  	      --l-number-divider-color: {{ block.settings.divider_color }};
  	      --l-label-color: {{ block.settings.label_color }};
  	  {%- endcase -%}
  	}
  	{% endfor %}
{%- endstyle -%}

{%- liquid
  # Set up fetch priority
  # ------------------------------------------------------------
  assign fetch_priority = 'auto'

  if section.index == 1
    assign fetch_priority = 'high'
  endif

  # Set up video
  # ------------------------------------------------------------
  assign video_id = section.settings.video.id | default: section.settings.video_url.id
-%}

{%- if section.settings.image_behavior == 'ambient' or section.settings.image_behavior == 'zoom-in' -%}
  {%- assign widths = '198, 432, 642, 900, 1284, 1800, 2000, 3000, 3840' -%}
  {%- capture sizes -%}
    (min-width: {{ section.settings.page_width }}px) {{ section.settings.page_width | minus: 100 | divided_by: 1.6667 }}px,
    (min-width: 750px) calc((100vw - 130px) / 1.667), calc((100vw - 50px) / 1.667)
  {%- endcapture -%}
{%- else -%}
  {%- assign widths = '165, 360, 535, 750, 1070, 1500, 1780, 2000, 3000, 3840' -%}
  {%- capture sizes -%}
    (min-width: {{ section.settings.page_width }}px) {{ section.settings.page_width | minus: 100 | divided_by: 2 }}px,
    (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)
  {%- endcapture -%}
{%- endif -%}

<div class="l-mwc{% unless section.settings.show_full_width %} page-width{% endunless %}">
  <div class="l-mwc l-mwc--{{ section.settings.content_layout }} isolate{% if settings.text_boxes_border_thickness > 0 and settings.text_boxes_border_opacity > 0 and settings.media_border_thickness > 0 and settings.media_border_opacity > 0 %} collapse-borders{% endif %}{% unless settings.media_border_thickness > 0 and settings.text_boxes_shadow_opacity == 0 and settings.text_boxes_border_thickness == 0 or settings.text_boxes_border_opacity == 0 %} collapse-corners{% endunless %}">
    <div class="l-mwc__grid grid grid--1-col{% if section.blocks.size > 0 %} grid--{% if section.settings.desktop_image_width == 'medium' %}2-col-tablet{% else %}3-col-tablet{% endif %}{% endif %}{% if section.settings.layout == 'text_first' %} l-mwc__grid--reverse{% endif %}">
      <div class="l-mwc__media-item l-mwc__media-item--{{ section.settings.desktop_image_width }} l-mwc__media-item--{{ section.settings.desktop_content_position }} grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {% comment %}
          ------------------------------------------------------------
          IMAGE
          ------------------------------------------------------------
        {% endcomment %}
        {%- if video_id == null -%}
          <picture
            class="l-mwc__media l-mwc__media--{{ section.settings.height }} global-media-settings{% if section.settings.image != blank %} media{% else %} l-mwc__media--placeholder placeholder{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}"
            {% if section.settings.height == 'adapt' and section.settings.image != blank %}
              style="padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;"
            {% endif %}
          >
            {%- if section.settings.image != blank -%}
              {%- if section.settings.image_mobile != blank -%}
                {{
                  section.settings.image_mobile
                  | image_url: width: 3840
                  | image_tag: class: 'banner__media-image', sizes: sizes, widths: widths, fetchpriority: fetch_priority
                  | replace: '<img', '<source media="(max-width: 750px)"'
                }}
              {%- endif -%}

              {{
                section.settings.image
                | image_url: width: 3840
                | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority
              }}
            {%- else -%}
              {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </picture>
        {%- endif -%}

        {% comment %}
          ------------------------------------------------------------
          VIDEO
          ------------------------------------------------------------
        {% endcomment %}
        {%- if video_id != null -%}
          {% liquid
            # Setup video poster / ratio / alt
            # ------------------------------------------------------------
            assign video_alt = section.settings.video.alt | default: section.settings.description
            assign alt = 'sections.video.load_video' | t: description: video_alt | escape
            assign poster = section.settings.video.preview_image | default: section.settings.cover_image

            if section.settings.video != null
              assign ratio_diff = section.settings.video.aspect_ratio | minus: poster.aspect_ratio | abs
              if ratio_diff < 0.01 and ratio_diff > 0
                assign fix_ratio = true
              endif
            endif
          %}
          <deferred-media
            class="video-section__media deferred-media l-mwc__media l-mwc__media--{{ section.settings.height }} global-media-settings{% if section.settings.full_width %} global-media-settings--full-width{% endif %}{% if fix_ratio %} media-fit-cover{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            data-media-id="{{ video_id }}"
            data-autoplay="{{ section.settings.video_autoplay }}"
            {% if poster != null %}
              style="--ratio-percent: {{ 1 | divided_by: poster.aspect_ratio | times: 100 }}%;"
            {% endif %}
          >
            <button
              id="Deferred-Poster-Modal-{{ video_id }}"
              class="video-section__poster media deferred-media__poster media--landscape"
              type="button"
              aria-label="{{ alt }}"
            >
              {%- if poster != null -%}
                {{ poster | image_url: width: 3840 | image_tag: sizes: sizes, widths: widths, alt: alt }}
              {%- else -%}
                {{ 'hero-apparel-3' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
              {%- endif -%}
              <span class="deferred-media__poster-button motion-reduce">
                {%- render 'icon-play' -%}
              </span>
            </button>
            <template>
              {%- if section.settings.video == null and section.settings.video_url != null -%}
                {%- liquid
                  # Setup video loop
                  # ------------------------------------------------------------
                  assign loop = ''

                  if section.settings.enable_video_looping
                    assign loop = '&loop=1&playlist=' | append: video_id
                  endif

                  if section.settings.video_autoplay == 'muted'
                    assign loop = loop | append: '&mute=1'
                  endif
                -%}
                {%- if section.settings.video_url.type == 'youtube' -%}
                  <iframe
                    src="https://www.youtube.com/embed/{{ video_id }}?enablejsapi=1&autoplay=1{{ loop }}"
                    class="js-youtube"
                    allow="autoplay; encrypted-media"
                    allowfullscreen
                    title="{{ section.settings.description | escape }}"
                  ></iframe>
                {%- else -%}
                  <iframe
                    src="https://player.vimeo.com/video/{{ video_id }}?autoplay=1{{ loop }}"
                    class="js-vimeo"
                    allow="autoplay; encrypted-media"
                    allowfullscreen
                    title="{{ section.settings.description | escape }}"
                  ></iframe>
                {%- endif -%}
              {%- else -%}
                {% liquid
                  # Setup autoplay
                  # ------------------------------------------------------------
                  assign controls = true
                  assign muted = false

                  if section.settings.video_autoplay == 'muted'
                    assign muted = true
                  endif
                %}
                {{
                  section.settings.video
                  | video_tag:
                    image_size: '1100x',
                    autoplay: true,
                    loop: section.settings.enable_video_looping,
                    controls: controls,
                    muted: muted
                }}
              {%- endif -%}
            </template>
          </deferred-media>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="l-mwc__text-item grid__item">
          <div
            id="MediaContents--{{ section.id }}"
            class="l-mwc__content l-mwc__content--{{ section.settings.desktop_content_position }} l-mwc__content--desktop-{{ section.settings.desktop_content_alignment }} l-mwc__content--mobile-{{ section.settings.mobile_content_alignment }} l-mwc__content--{{ section.settings.height }} content-container"
          >
            {%- for block in section.blocks -%}
              {% case block.type %}
                {%- when 'icon' -%}
                  <div
                    id="{{ section.id }}-{{ block.id }}"
                    class="l-mwc__icon l-dynamic l-dynamic--media {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                    {{ block.shopify_attributes }}
                  >
                    {%- if block.settings.image != blank -%}
                      {%- assign image_height = block.settings.icon_width
                        | divided_by: block.settings.image.aspect_ratio
                      -%}
                      {{
                        block.settings.image
                        | image_url: width: block.settings.icon_width
                        | image_tag: width: block.settings.icon_width, height: image_height, loading: 'lazy'
                      }}
                    {%- elsif block.settings.svg != blank -%}
                      {{ block.settings.svg }}
                    {%- else -%}
                      {{ 'image' | placeholder_svg_tag }}
                    {%- endif -%}
                  </div>
                {%- when 'heading' -%}
                  <h2
                    id="{{ section.id }}-{{ block.id }}"
                    class="l-mwc__heading l-dynamic l-dynamic--text inline-richtext {{ block.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.heading }}
                  </h2>
                {%- when 'caption' -%}
                  <p
                    id="{{ section.id }}-{{ block.id }}"
                    class="l-mwc__text l-mwc__text--caption l-dynamic l-dynamic--text {{ block.settings.text_style }} {{ block.settings.text_style }}--{{ block.settings.text_size }} {{ block.settings.text_style }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.caption | escape }}
                  </p>
                {%- when 'text' -%}
                  <div
                    id="{{ section.id }}-{{ block.id }}"
                    class="l-mwc__text l-dynamic l-dynamic--text rte {{ block.settings.text_style }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.text }}
                  </div>

                {%- when 'chat_button' -%}
                  {% render 'chat-button', block: block %}

                {%- when 'buttons' -%}
                  <div
                    id="{{ section.id }}-{{ block.id }}"
                    class="l-mwc__buttons l-dynamic l-button__group flex flex-wrap items-center{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                    {{ block.shopify_attributes }}
                  >
                    {%- if block.settings.first_button_label != blank -%}
                      <a
                        {% if block.settings.first_button_link == blank %}
                          role="link" aria-disabled="true"
                        {% else %}
                          href="{{ block.settings.first_button_link }}"
                        {% endif %}
                        class="l-button--dynamic l-button--primary l-button--mobile-full button"
                      >
                        {%- capture icon -%}
												{%- if block.settings.first_icon -%}
													{{
													block.settings.first_icon
													| image_url: width: block.settings.first_icon_width
													| image_tag
													}}
												{%- endif -%}
												{%- endcapture -%}
                        {%- if block.settings.first_icon_position == 'icon_with_text' -%}
                          {{ icon }}
                        {%- endif -%}
                        {{- block.settings.first_button_label | escape -}}
                        {%- if block.settings.first_icon_position == 'text_with_icon' -%}
                          {{ icon }}
                        {%- endif -%}
                      </a>
                    {%- endif -%}
                    {%- if block.settings.second_button_label != blank -%}
                      <a
                        {% if block.settings.second_button_link == blank %}
                          role="link" aria-disabled="true"
                        {% else %}
                          href="{{ block.settings.second_button_link }}"
                        {% endif %}
                        class="l-button--dynamic l-button--secondary l-button--mobile-full button"
                      >
                        {{- block.settings.second_button_label | escape -}}
                      </a>
                    {%- endif -%}
                  </div>

                {%- when 'count_down' -%}
                  <script src="{{ 'lta-components-count-down.js' |  asset_url }}" defer="defer"></script>

                  <l-count-down
                    id="{{ section.id }}-{{ block.id }}"
                    class="l-mwc-countdown l-dynamic block{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                    {{ block.shopify_attributes }}
                    role="timer"
                    data-end-date="{{ block.settings.count_down }}"
                    aria-label="{{ block.settings.count_down }}"
                  >
                    <div class="l-mwc-countdown__grid flex items-center flex-wrap">
                      <div class="l-mwc-countdown__item text-center">
                        <div class="l-mwc-countdown__number flex items-center justify-center js-days">0</div>
                        <div class="l-mwc-countdown__label">{{ block.settings.days }}</div>
                      </div>
                      <span class="l-mwc-countdown__divider flex items-center justify-center">:</span>
                      <div class="l-mwc-countdown__item text-center">
                        <div class="l-mwc-countdown__number flex items-center justify-center js-hours">0</div>
                        <div class="l-mwc-countdown__label">{{ block.settings.hours }}</div>
                      </div>
                      <span class="l-mwc-countdown__divider flex items-center justify-center">:</span>
                      <div class="l-mwc-countdown__item text-center">
                        <div class="l-mwc-countdown__number flex items-center justify-center js-mins">0</div>
                        <div class="l-mwc-countdown__label">{{ block.settings.minutes }}</div>
                      </div>
                      <span class="l-mwc-countdown__divider flex items-center justify-center">:</span>
                      <div class="l-mwc-countdown__item text-center">
                        <div class="l-mwc-countdown__number flex items-center justify-center js-secs">0</div>
                        <div class="l-mwc-countdown__label">{{ block.settings.seconds }}</div>
                      </div>
                    </div>
                  </l-count-down>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "LTA - Founder",
  "class": "section l-founder",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "page_width",
      "min": 600,
      "max": 1600,
      "step": 100,
      "default": 1200,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.page_width.label"
    },
    {
      "type": "checkbox",
      "id": "show_full_width",
      "label": "Show full width",
      "default": false
    },
    {
      "type": "range",
      "id": "spacing_grid_horizontal",
      "min": 4,
      "max": 40,
      "step": 4,
      "default": 8,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.spacing_grid_horizontal.label"
    },
    {
      "type": "range",
      "id": "spacing_grid_vertical",
      "min": 4,
      "max": 40,
      "step": 4,
      "default": 8,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.spacing_grid_vertical.label"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image desktop"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image mobile"
    },
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "checkbox",
      "id": "enable_video_looping",
      "label": "t:sections.video.settings.enable_video_looping.label",
      "default": false
    },
    {
      "type": "select",
      "id": "video_autoplay",
      "label": "Video autoplay",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "muted",
          "label": "Muted"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": "t:sections.video.settings.header__1.content"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:sections.video.settings.video.label"
    },
    {
      "type": "paragraph",
      "content": "t:sections.video.settings.header__2.content"
    },
    {
      "type": "paragraph",
      "content": "t:sections.video.settings.paragraph.content"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "default": "https://www.youtube.com/watch?v=_9VUPq3SxOc",
      "label": "t:sections.video.settings.video_url.label",
      "info": "t:sections.video.settings.video_url.info"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "t:sections.video.settings.cover_image.label"
    },
    {
      "type": "text",
      "id": "description",
      "label": "t:sections.video.settings.description.label",
      "info": "t:sections.video.settings.description.info"
    },
    {
      "type": "header",
      "content": "Media settings"
    },
    {
      "type": "select",
      "id": "height",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.image-with-text.settings.height.options__1.label"
        },
        {
          "value": "small",
          "label": "t:sections.image-with-text.settings.height.options__2.label"
        },
        {
          "value": "medium",
          "label": "t:sections.image-with-text.settings.height.options__3.label"
        },
        {
          "value": "large",
          "label": "t:sections.image-with-text.settings.height.options__4.label"
        }
