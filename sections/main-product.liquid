<script>
  document.addEventListener('DOMContentLoaded', () => {
    const popUpBtn = document.querySelector('#openPopupBtn');
    const inputs = document.querySelectorAll('.swatch-input__input');

    function updateActiveState() {
      if (!popUpBtn) return;

      const blockSettings = window.productVideoOptions || {};

      // Check for each option if BOTH swatch checked AND block checkbox true
      const showCorten =
        blockSettings.cortenSteel &&
        Array.from(inputs).some((input) => input.checked && input.value === 'Corten Steel');
      const showStainless =
        blockSettings.stainlessSteel &&
        Array.from(inputs).some((input) => input.checked && input.value === 'Stainless Steel');
      const showBlackPowder =
        blockSettings.blackPowder &&
        Array.from(inputs).some((input) => input.checked && input.value === 'Black Powder Coated');
      const showCoatedBlack =
        blockSettings.coatedSteelBlack &&
        Array.from(inputs).some((input) => input.checked && input.value === 'Coated Steel Black');

      // Show button if any of the combined conditions are true
      const shouldShow = showCorten || showStainless || showBlackPowder || showCoatedBlack;
      popUpBtn.classList.toggle('show', shouldShow);
    }

    // Initial check
    updateActiveState();

    // Listen to swatch input changes
    inputs.forEach((input) => input.addEventListener('change', updateActiveState));
  });
</script>
