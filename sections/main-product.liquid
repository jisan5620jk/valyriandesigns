<section
  id="MainProduct-{{ section.id }}"
  class="l-product section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}"
  data-section="{{ section.id }}"
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
  {% endunless %}
  {%- if product.quantity_price_breaks_configured? -%}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  {%- endif -%}
  {{ 'lta-sections-main-product.css' | asset_url | stylesheet_tag }}

  {%- style -%}
    .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    }
    .product.product--large {
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
    }
    /* Style for the popup */
    .popup {
    display: none;
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(.7);
    width: 80%;
    height: 100%;
    max-width: 800px;
    padding: 80px 40px;
    border-radius: 10px;
    z-index: 99999999;
    transition: transform 0.3s ease-in-out, opacity 0.3s ease-in-out;
    opacity: 0;
    }

    /* Show the popup with animation */
    .popup.show {
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
    }

    .popup-video {
    background-color: #fff;
    padding: 30px;
    border-radius: 10px;
    height: 100%;
    width: 100%;
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.5);
    }

    .popup-video video {

    border-radius: 10px;
    }

    /* Style for the overlay */
    .overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 9999999;
    }

    /* Show the overlay */
    .overlay.show {
    display: block;
    }

    /* Style for the close button */
    .close-btn {
    position: absolute;
    top: 30px;
    right: 0px;
    font-size: 36px;
    color: #000000;
    cursor: pointer;
    width: 50px;
    height: 50px;
    transition: color 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
    border-radius: 50px;
    }

    .close-btn:hover {
    color: #fff;
    background: black;
    }

    /* Style for the button */
    #openPopupBtn {
    padding: 10px 20px;
    font-size: 16px;
    color: #fff;
    background-color: black;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    transition: all 0.3s ease;
    border: 1px solid #000;
    position: absolute;
    bottom: 30px;
    right: 30px;
    align-items: center;
    justify-content: center;
    gap: 6px;
    display: none !important;
    }
    button#openPopupBtn:hover {
    color: #000;
    background-color: #fff;
    }

    .open-popup-mobile {
    display: none;
    }
    #openPopupBtn.show {
    display: flex !important;
    }
    @media screen and (max-width: 991px) {
    .open-popup-mobile {
    display: block;
    }
    }

    @media screen and (max-width:991px) {
    .open-popup-desktop {
    display: none;
    }
    }

    .video-container {
    display: none; /* Hide all videos by default */
    position: relative;
    z-index: 1;
    height: 100%;
    width: 100%;
    cursor: pointer;
    }

    .video-container.active {
    display: block; /* Show active video */
    }

    .play-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 48px;
    color: white;
    display: flex;
    width: 70px;
    height: 70px;
    background: black;
    border-radius: 50%;akta
    align-items: center;
    align-items: center;
    justify-content: center;
    padding: 0;
    opacity: 0;
    transition: opacity 0.3s ease;
    }

    .video-container.active.paused .play-icon {
    opacity: 1;
    }

    .product-video source {
    z-index: 999;
    position: relative;
    }


    .l-pwt__image-richtext {
    max-width: var(--l-image-content-width,382px) !important;
    }

    @media screen and (max-width: 575px) {
    .l-pwt__image-richtext {
    left: 20px !important;
    font-size: 12px !important;
    }
    }

    @media screen and (max-width: 991px) {
    .close-btn {
    top: 30px;
    right: 30px;
    font-size: 30px;
    width: 30px;
    height: 30px;
    }
    .popup-video {
    padding: 20px;
    }
    }
    @media screen and (max-width: 768px){
    .popup-video {
    padding: 20px;
    width: 90%;
    margin: auto;
    }
    }
    @media screen and (max-width: 575px) {
    .popup {
    padding: 30px 0px;
    height: auto;
    width: 93%;
    }
    .close-btn {
    top: 0;
    right: 30px;
    }

    button#openPopupBtn {
    padding: 5px 10px;
    font-size: 14px;
    }
    .popup-video {
    padding: 10px;
    width: 80%;
    margin: auto;
    }
    }
  {%- endstyle -%}

  <script src="{{ 'lta-components-product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'lta-components-product-form.js' | asset_url }}" defer="defer"></script>
  {%- if product.quantity_price_breaks_configured? -%}
    <script src="{{ 'lta-components-show-more.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'lta-components-price-per-item.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}
  <script src="{{ 'lta-sections-main-product.js' | asset_url }}" defer="defer"></script>

  {% if section.settings.image_zoom == 'hover' %}
    <script id="EnableZoomOnHover-main" src="{{ 'lta-components-magnify.js' | asset_url }}" defer="defer"></script>
  {% endif %}
  {%- if request.design_mode -%}
    <script src="{{ 'lta-theme-editor.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
  {%- if first_3d_model -%}
    {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
    <link
      id="ModelViewerStyle"
      rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print"
      onload="this.media='all'"
    >
    <link
      id="ModelViewerOverride"
      rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}

  {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}
  <div class="l-product__container page-width">
    <div class="product__title page-width">
      {% comment %} <h1>{{ product.title | escape }}</h1>
      <a href="{{ product.url }}" class="product__title">
        <h2 class="h1">
          {{ product.title | escape }}
        </h2>
      </a> {% endcomment %}

      {%- assign product_title = product.selected_or_first_available_variant.metafields.custom.product_title -%}
      {% if product_title != blank %}
        <h1 id="product_title-{{ section.id }}">{{ product_title | escape }}</h1>
      {% else %}
        <h1>{{ product.title | escape }}</h1>
      {% endif %}
    </div>

    <div class="product product--{{ section.settings.media_size }} product--{{ section.settings.media_position }} product--{{ section.settings.gallery_layout }} product--mobile-{{ section.settings.mobile_thumbnails }} grid grid--1-col {% if product.media.size > 0 %}grid--2-col-tablet{% else %}product--no-media{% endif %}">
      <div class="grid__item product__media-wrapper">
        {% render 'product-media-gallery-akta-service', variant_images: variant_images %}
      </div>
      <div class="product__info-wrapper grid__item{% if settings.page_width > 1400 and section.settings.media_size == "small" %} product__info-wrapper--extra-padding{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <product-info
          id="ProductInfo-{{ section.id }}"
          data-section="{{ section.id }}"
          data-url="{{ product.url }}"
          class="product__info-container{% if section.settings.enable_sticky_info %} product__column-sticky{% endif %}"
        >
          {%- assign product_form_id = 'product-form-' | append: section.id -%}

          {%- for block in section.blocks -%}
            {% render 'product-all-blocks',
              section: section,
              block: block,
              product: product,
              product_form_id: product_form_id
            %}
          {%- endfor -%}
          <a href="{{ product.url }}" class="link product__view-details animate-arrow">
            {{ 'products.product.view_full_details' | t }}
            {% render 'icon-arrow' %}
          </a>
        </product-info>
      </div>
    </div>

    {% render 'product-media-modal', variant_images: variant_images %}

    {% comment %}
      ------------------------------------------------------------
      [START]: POPUP MODAL
      ------------------------------------------------------------
    {% endcomment %}
    {% assign popups = section.blocks | where: 'type', 'popup' %}
    {%- for block in popups -%}
      <modal-dialog id="PopupModal-{{ block.id }}" class="product-popup-modal" {{ block.shopify_attributes }}>
        <div
          role="dialog"
          aria-modal="true"
          class="product-popup-modal__content{% if block.settings.video != blank %} product-popup-modal__content--video{% endif %}"
          tabindex="-1"
        >
          <button
            id="ModalClose-{{ block.id }}"
            type="button"
            class="product-popup-modal__toggle"
            aria-label="{{ 'accessibility.close' | t }}"
          >
            {% render 'icon-close' %}
          </button>
          {%- if block.settings.page.content != blank -%}
            <div class="product-popup-modal__content-info">
              {{ block.settings.page.content }}
            </div>
          {%- endif -%}
        </div>
      </modal-dialog>
    {%- endfor -%}

    {% comment %}
      ------------------------------------------------------------
      [START]: POPUP VIDEO MODAL
      ------------------------------------------------------------
    {% endcomment %}
    {% assign popup_videos = section.blocks | where: 'type', 'popup_videos' %}
    {%- if popup_videos.size -%}
      {{ 'video-section.css' | asset_url | stylesheet_tag }}
      {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
    {%- endif -%}
    {%- for block in popup_videos -%}
      {%- for index in (1..2) -%}
        {%- assign meta_key = 'popup_video_url_' | append: index -%}
        {%- assign meta_video_url = product.metafields.custom[meta_key] -%}
        {%- if meta_video_url == blank -%}{%- continue -%}{%- endif -%}

        {%- assign cover_key = 'cover_image_' | append: index -%}
        {%- assign poster = block.settings[cover_key] -%}

        {%- if meta_video_url contains 'youtube.com' or meta_video_url contains 'youtu.be' -%}
          {%- assign video_type = 'youtube' -%}
          {%- assign video_id = meta_video_url | split: 'v=' | last | split: '&' | first -%}
        {%- elsif meta_video_url contains 'vimeo.com' -%}
          {%- assign video_type = 'vimeo' -%}
          {%- assign video_id = meta_video_url | split: '/' | last | split: '?' | first -%}
        {%- else -%}
          {%- assign video_type = 'direct' -%}
          {%- assign video_id = meta_video_url -%}
        {%- endif -%}

        <modal-dialog
          id="PopupModal-{{ block.id }}-{{ index }}"
          class="product-popup-modal"
          {{ block.shopify_attributes }}
        >
          <div
            role="dialog"
            aria-modal="true"
            class="product-popup-modal__content product-popup-modal__content--video"
            tabindex="-1"
          >
            <button
              id="ModalClose-{{ block.id }}-{{ index }}"
              type="button"
              class="product-popup-modal__toggle"
              aria-label="{{ 'accessibility.close' | t }}"
            >
              {% render 'icon-close' %}
            </button>
            <deferred-media
              class="video-section__media deferred-media gradient global-media-settings{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              data-media-id="{{ video_id }}"
              {% if poster != null %}
                style="--ratio-percent-mobile: 100%;--ratio-percent: {{ 1 | divided_by: poster.aspect_ratio | times: 100 }}%;"
              {% endif %}
            >
              <button
                id="Deferred-Poster-Modal-{{ video_id }}"
                class="video-section__poster media deferred-media__poster media--landscape"
                type="button"
                aria-label="{{ 'sections.video.load_video' | t: description: '' }}"
              >
                {%- if poster != null -%}
                  {{ poster | image_url: width: 3840 | image_tag: widths: '375, 750, 1100, 1500, 1780, 2000, 3000, 3840' }}
                {%- else -%}
                  {{ 'hero-apparel-3' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
                {%- endif -%}
                <span class="deferred-media__poster-button motion-reduce">
                  {%- render 'icon-play' -%}
                </span>
              </button>
              <template>
                {%- if video_type == 'youtube' -%}
                  <iframe
                    src="https://www.youtube.com/embed/{{ video_id }}?enablejsapi=1&autoplay=1"
                    class="js-youtube"
                    allow="autoplay; encrypted-media"
                    allowfullscreen
                    title="Video {{ index }}"
                  ></iframe>
                {%- elsif video_type == 'vimeo' -%}
                  <iframe
                    src="https://player.vimeo.com/video/{{ video_id }}?autoplay=1"
                    class="js-vimeo"
                    allow="autoplay; encrypted-media"
                    allowfullscreen
                    title="Video {{ index }}"
                  ></iframe>
                {%- else -%}
                  <video src="{{ video_id }}" autoplay controls loop></video>
                {%- endif -%}
              </template>
            </deferred-media>
          </div>
        </modal-dialog>
      {%- endfor -%}
    {%- endfor -%}
    {% comment %}
      ------------------------------------------------------------
      [END]: POPUP VIDEO
      ------------------------------------------------------------
    {% endcomment %}

    {%- if product.media.size > 0 -%}
      <script src="{{ 'lta-components-product-modal.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'lta-components-media-gallery.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- if first_3d_model -%}
      <script type="application/json" id="ProductJSON-{{ product.id }}">
        {{ product.media | where: 'media_type', 'model' | json }}
      </script>
      <script src="{{ 'lta-components-product-model.js' | asset_url }}" defer></script>
    {%- endif -%}

    {%- liquid
      if product.selected_or_first_available_variant.featured_media
        assign seo_media = product.selected_or_first_available_variant.featured_media
      else
        assign seo_media = product.featured_media
      endif
    -%}

    <script type="application/ld+json">
      {
        "@context": "http://schema.org/",
        "@type": "Product",
        "name": {{ product.title | json }},
        "url": {{ request.origin | append: product.url | json }},
        {% if seo_media -%}
          "image": [
            {{ seo_media | image_url: width: 1920 | prepend: "https:" | json }}
          ],
        {%- endif %}
        "description": {{ product.description | strip_html | json }},
        {% if product.selected_or_first_available_variant.sku != blank -%}
          "sku": {{ product.selected_or_first_available_variant.sku | json }},
        {%- endif %}
        "brand": {
          "@type": "Brand",
          "name": {{ product.vendor | json }}
        },
        "offers": [
          {%- for variant in product.variants -%}
            {
              "@type" : "Offer",
              {%- if variant.sku != blank -%}
                "sku": {{ variant.sku | json }},
              {%- endif -%}
              {%- if variant.barcode.size == 12 -%}
                "gtin12": {{ variant.barcode }},
              {%- endif -%}
              {%- if variant.barcode.size == 13 -%}
                "gtin13": {{ variant.barcode }},
              {%- endif -%}
              {%- if variant.barcode.size == 14 -%}
                "gtin14": {{ variant.barcode }},
              {%- endif -%}
              "availability" : "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
              "price" : {{ variant.price | divided_by: 100.00 | json }},
              "priceCurrency" : {{ cart.currency.iso_code | json }},
              "url" : {{ request.origin | append: variant.url | json }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>
  </div>
</section>

<script>
  // Get elements
  const openPopupBtn = document.getElementById('openPopupBtn');
  const closePopupBtn = document.getElementById('closePopupBtn');
  const popup = document.getElementById('popup');
  const overlay = document.getElementById('overlay');

  // Open the popup
  openPopupBtn.addEventListener('click', () => {
    popup.style.display = 'block';
    overlay.style.display = 'block';
    setTimeout(() => {
      popup.classList.add('show');
      overlay.classList.add('show');
    }, 10); // Slight delay to trigger the transition
  });

  // Close the popup
  closePopupBtn.addEventListener('click', () => {
    popup.classList.remove('show');
    overlay.classList.remove('show');
    setTimeout(() => {
      popup.style.display = 'none';
      overlay.style.display = 'none';
    }, 300); // Match the transition duration
  });

  // Close the popup when clicking outside of it
  overlay.addEventListener('click', () => {
    popup.classList.remove('show');
    overlay.classList.remove('show');
    setTimeout(() => {
      popup.style.display = 'none';
      overlay.style.display = 'none';
    }, 300); // Match the transition duration
  });
</script>

<script>
  const openBtn = document.getElementById('openPopupBtn');

  if (openBtn) {
    openBtn.addEventListener('click', function () {
      const thumbnails = document.querySelectorAll('.thumbnail-list__item:first-child button.is-active');
      const videoContainers = document.querySelectorAll('.video-container');
      const videos = document.querySelectorAll('.product-video');
      const closeButtons = document.querySelectorAll('#closePopupBtn, #overlay');

      thumbnails.forEach((activeButton) => {
        const image = activeButton.querySelector('img');

        if (image) {
          const altText = image.alt;

          videos.forEach((video, index) => {
            const dataID = video.getAttribute('data-id');
            const container = videoContainers[index];

            if (dataID === altText) {
              container.classList.add('active');
              container.style.display = 'block';
              video.muted = false;
              video.load();
              video.play();
            } else {
              container.classList.remove('active');
              container.style.display = 'none';
              video.pause();
              video.muted = true;
            }
          });
        }
      });

      // Close buttons
      closeButtons.forEach((button) => {
        button.addEventListener('click', () => {
          videoContainers.forEach((container) => {
            container.style.display = 'none';
            container.classList.remove('active');
          });

          videos.forEach((video) => {
            video.pause();
            video.muted = true;
          });
        });
      });
    });
  }
</script>

<script>
  const videoContainers = document.querySelectorAll('.video-container');
  const videos = document.querySelectorAll('.product-video'); // Select all product-video elements

  videoContainers.forEach((container, index) => {
    const pauseOtherVideos = () => {
      videos.forEach((video, videoIndex) => {
        if (videoIndex !== index) {
          video.pause(); // Pause all other videos
          video.muted = true;
          videoContainers[videoIndex].classList.add('paused'); // Add 'paused' class to other video containers
        }
      });
    };

    container.addEventListener('click', () => {
      if (videos[index].paused) {
        pauseOtherVideos(); // Pause other videos before playing this one
        videos[index].play();
        videos[index].muted = false; // Sound on when playing
        container.classList.remove('paused'); // Remove 'paused' class when playing
      } else {
        videos[index].pause();
        videos[index].muted = true; // Mute on when paused
        container.classList.add('paused'); // Add 'paused' class when paused
      }
    });
  });
</script>

