	],
	"presets": [
		{
			"name": "LTA - Icon with text",
			"blocks": [
				{
					"type": "icon_with_text"
				},
				{
					"type": "icon_with_text"
				},
				{
					"type": "icon_with_text"
				},
				{
					"type": "icon_with_text"
				}
			]
		}
	]
