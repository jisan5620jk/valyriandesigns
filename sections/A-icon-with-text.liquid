				},
				{
					"type": "url",
					"id": "link",
					"label": "Link URL"
				},
				{
					"type": "range",
					"id": "button_radius",
					"label": "Button corner radius",
					"min": 0,
					"max": 40,
					"step": 2,
					"unit": "px",
					"default": 10
				},
				{
					"type": "header",
					"content": "Colors"
				},
				{
					"type": "color",
					"id": "icon_box_bg",
					"label": "Icon box",
