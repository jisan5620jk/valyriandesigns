				},
				{
					"type": "color",
					"id": "title_color",
					"label": "Title",
					"default": "#000"
				},
				{
					"type": "color",
					"id": "subtitle_color",
					"label": "Subtitle",
					"default": "#000"
				},
				{
					"type": "color",
					"id": "button_text",
					"label": "Button text",
					"default": "#fff"
				},
				{
					"type": "color",
					"id": "button_bg",
