{{ 'lta-sections-steps.css' | asset_url | stylesheet_tag }}

{% style %}
	#shopify-section-{{ section.id }} {
	  padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
	  padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
	}

	@media screen and (min-width: 750px) {
	  #shopify-section-{{ section.id }} {
	    padding-top: {{ section.settings.padding_top }}px;
	    padding-bottom: {{ section.settings.padding_bottom }}px;
	  }
	}
{% endstyle %}

<div class="l-order-steps page-width">
	<div class="l-order-steps__header">{{ section.settings.title }}</div>
	<div class="l-order-steps__list grid grid--3-col-tablet grid--1-col">
		{%- for block in section.blocks -%}
			<div class="l-order-steps__item grid__item">
				<div class="l-order-steps__content">
					<span>{{ block.settings.title }}</span>
					<div>{{ block.settings.description }}</div>
				</div>
				<div class="l-order-steps__media">
					{%- if block.settings.image != blank -%}
						{{ block.settings.image | image_url: width: 200 | image_tag: loading: 'lazy' }}
					{%- endif -%}
				</div>
			</div>
		{%- endfor -%}
	</div>
</div>

{% schema %}
{
	"name": "LTA - Steps",
	"settings": [
		{
			"type": "text",
			"id": "title",
			"label": "Title",
			"default": "3 Easy Steps to Build Your Own"
		},
		{
			"type": "header",
			"content": "t:sections.all.padding.section_padding_heading"
		},
		{
			"type": "range",
			"id": "padding_top",
			"min": 0,
			"max": 100,
			"step": 4,
			"unit": "px",
			"label": "t:sections.all.padding.padding_top",
			"default": 36
		},
		{
			"type": "range",
			"id": "padding_bottom",
			"min": 0,
			"max": 100,
			"step": 4,
			"unit": "px",
			"label": "t:sections.all.padding.padding_bottom",
			"default": 36
		}
	],
	"blocks": [
		{
			"name": "Step",
			"type": "step",
			"settings": [
				{
					"type": "text",
					"id": "title",
					"label": "Title",
					"default": "Step 1"
				},
				{
					"type": "richtext",
					"id": "description",
					"label": "Description"
				},
				{
					"type": "image_picker",
					"id": "image",
					"label": "Image"
				}
			]
		}
	],
	"presets": [
		{
			"name": "LTA - Steps"
		}
	]
}
{% endschema %}
