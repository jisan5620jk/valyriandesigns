{{ 'lta-sections-community.css' | asset_url | stylesheet_tag }}

{% style %}
	#shopify-section-{{ section.id }} {
	  padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
	  padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
	}

	@media screen and (min-width: 750px) {
	  #shopify-section-{{ section.id }} {
	    padding-top: {{ section.settings.padding_top }}px;
	    padding-bottom: {{ section.settings.padding_bottom }}px;
	  }
	}
{% endstyle %}

<div class="l-community">
	{%- for block in section.blocks -%}
		<div class="l-community__block">
			{%- if block.settings.image != blank -%}
				{% comment %} style="padding-bottom: {{ 1 | divided_by: block.settings.image.aspect_ratio | times: 100 }}%;" {% endcomment %}
				<div
					class="media media--transparent media--adapt"
					style="padding-bottom: 100%;"
				>
					{{
						block.settings.image
						| image_url: width: 3200
						| image_tag:
							widths: '50, 75, 100, 150, 200, 300, 400, 500, 750, 1000, 1250, 1500, 1750, 2000, 2250, 2500, 2750, 3000, 3200',
							sizes: '(min-width: 750px) 25vw, 100vw',
							class: 'l-community__block-img'
					}}
				</div>
			{%- endif -%}
		</div>
		{%- if forloop.first -%}
			<div class="l-community__block l-community__block--2-block flex items-center justify-center center">
				<div class="l-community__block-content">
					<h2 class="l-community__block-title">
						{{ section.settings.title }}
					</h2>
					<div class="l-community__socials">
						{%- if section.settings.x_url != blank -%}
							<a
								href="{{ section.settings.x_url }}"
								target="_blank"
								class="l-community__socials-link"
							>
								<svg
									width="39"
									height="39"
									viewBox="0 0 39 39"
									fill="none"
									xmlns="http://www.w3.org/2000/svg"
								>
									<path d="M27.1716 9H30.6971L22.9563 17.9114L32 30H24.903L19.3466 22.6539L12.9853 30H9.45985L17.6604 20.4686L9 9H16.2732L21.2932 15.7107L27.1716 9ZM25.9377 27.9077H27.892L15.2463 11.0148H13.1463L25.9377 27.9077Z" fill="black"/>
								</svg>
							</a>
						{%- endif -%}
						{%- if section.settings.linkedin_url != blank -%}
							<a
								href="{{ section.settings.linkedin_url }}"
								target="_blank"
								class="l-community__socials-link"
