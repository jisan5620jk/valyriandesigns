{%- style -%}
	.section-{{ section.id }}-padding {
	  background-color: {{ section.settings.background }};
	  padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
	  padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
	}

	@media screen and (min-width: 750px) {
	  .section-{{ section.id }}-padding {
	    padding-top: {{ section.settings.padding_top }}px;
	    padding-bottom: {{ section.settings.padding_bottom }}px;
	  }
	}

	.grid {
		align-items: start !important;
	}


a.l-button--dynamic.l-button--dynamic-first.button {
  overflow: hidden;
  transition: all 0.3s;
  position: relative;
  z-index: 1;
}
a.l-button--dynamic.l-button--dynamic-first.button:hover {
  color: white;
  outline: none;
}
a.l-button--dynamic.l-button--dynamic-first.button img {
  transition: all 0.3s;
}
a.l-button--dynamic.l-button--dynamic-first.button:hover img {
  filter: brightness(0) invert(1);
}
a.l-button--dynamic.l-button--dynamic-first.button:before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 0;
  height: 100%;
  background: black;
  z-index: -1;
  transition: all 0.3s;
}
a.l-button--dynamic.l-button--dynamic-first.button:hover:before {
  width: 100%;
  left: 0;
}

@media screen and (min-width: 992px) and (max-width: 1280px) {
  a.l-button--dynamic.l-button--dynamic-first.button {
    gap: 6px !important;
    padding: 10px 10px !important;
    font-size: 11px !important;
  }
}


@media screen and (max-width: 380px) {
.l-button--dynamic.l-button--dynamic-first.button {
    gap: 4px !important;
    padding: 6px 10px !important;
    font-size: 11px !important;
}
}


	{% for block in section.blocks %}
	#{{ section.id }}-{{ block.id }} {
	  --page-width: {{ block.settings.page_width }}px;
	  --l-mt: {{ block.settings.padding_top }}px;
	  --l-mb: {{ block.settings.padding_bottom }}px;
	   {% if block.settings.text_color %}
	  --l-color: {{ block.settings.text_color }};
	  {% endif %}
	  {%- case block.type -%}
	    {%- when 'text' -%}
	      --l-link-color: {{ block.settings.link_color }};
	    {% when 'buttons' %}
	      --l-buttons-gap: {{ block.settings.buttons_gap }}px;
	      {% if block.settings.first_button_label %}
	      .l-button--dynamic-first {
	        --color-button: {{ block.settings.first_button_bg.red }},{{ block.settings.first_button_bg.green }},{{ block.settings.first_button_bg.blue }};
	        --color-button-text: {{ block.settings.first_button_text.red }},{{ block.settings.first_button_text.green }},{{ block.settings.first_button_text.blue }};
	        --button-font-weight: {{ block.settings.first_font_weight }};
	        --button-border-width: {{ block.settings.first_button_border_width }}px;
	        --button-border-radius: {{ block.settings.first_button_border_radius }}px;
	        --button-border-color: {{ block.settings.first_button_border.red }},{{ block.settings.first_button_border.green }},{{ block.settings.first_button_border.blue }};
	      }
	      {% endif %}
	      {% if block.settings.second_button_label %}
	      .l-button--dynamic-second {
	        --color-button: {{ block.settings.second_button_bg.red }},{{ block.settings.second_button_bg.green }},{{ block.settings.second_button_bg.blue }};
	        --color-button-text: {{ block.settings.second_button_text.red }},{{ block.settings.second_button_text.green }},{{ block.settings.second_button_text.blue }};
	        --button-font-weight: {{ block.settings.second_font_weight }};
	        --button-border-width:{{ block.settings.second_button_border_width }}px;
	        --button-border-radius: {{ block.settings.second_button_border_radius }}px;
	        --button-border-color: {{ block.settings.second_button_border.red }},{{ block.settings.second_button_border.green }},{{ block.settings.second_button_border.blue }};
	      }
	      {% endif %}
	    {% when 'icon' %}
	      --l-width: {{ block.settings.icon_width }}px;
	    {% when 'image' %}
	      --l-width: {% if block.settings.show_image_full_width %} 100% {% else %}{{ block.settings.image_width }}px{% endif %};
	    {% when 'count_down' %}
	      --l-number-bg: {{ block.settings.number_bg }};
	      --l-number-color: {{ block.settings.number_color }};
	      --l-number-divider-color: {{ block.settings.divider_color }};
	      --l-label-color: {{ block.settings.label_color }};
	  {%- endcase -%}
	}
	{% endfor %}
{%- endstyle -%}

<div class="l-custom-content isolate section-{{ section.id }}-padding overflow-hidden">
	<div class="l-custom-content__wrapper l-custom-content__wrapper--{{ section.settings.desktop_content_position }}">
		{%- for block in section.blocks -%}
			{%- case block.type -%}
				{%- when 'caption' -%}
					<p
						id="{{ section.id }}-{{ block.id }}"
						class="page-width l-custom-content__caption l-dynamic l-dynamic--text l-dynamic--content-mobile-{{ block.settings.text_alignment_mobile }} l-dynamic--content-desktop-{{ block.settings.text_alignment_desktop }} {{ block.settings.text_style }} {{ block.settings.text_style }}--{{ block.settings.text_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
						{% if settings.animations_reveal_on_scroll %}
							data-cascade
							style="--animation-order: {{ forloop.index }};"
						{% endif %}
						{{ block.shopify_attributes }}
					>
						{{ block.settings.caption | escape }}
					</p>
				{%- when 'heading' -%}
					<{{ block.settings.tag }}
						id="{{ section.id }}-{{ block.id }}"
						class="page-width l-custom-content__heading l-dynamic l-dynamic--text l-dynamic--content-mobile-{{ block.settings.text_alignment_mobile }} l-dynamic--content-desktop-{{ block.settings.text_alignment_desktop }} rte inline-richtext {{ block.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
						{% if settings.animations_reveal_on_scroll %}
							data-cascade
							style="--animation-order: {{ forloop.index }};"
						{% endif %}
						{{ block.shopify_attributes }}
					>
						{{ block.settings.heading }}
						{{ block.settings.liquid }}
					</{{ block.settings.tag }}>
				{%- when 'text' -%}
					<div
						id="{{ section.id }}-{{ block.id }}"
						class="page-width l-custom-content__text l-dynamic l-dynamic--text l-dynamic--content-mobile-{{ block.settings.text_alignment_mobile }} l-dynamic--content-desktop-{{ block.settings.text_alignment_desktop }} rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
						{% if settings.animations_reveal_on_scroll %}
							data-cascade
							style="--animation-order: {{ forloop.index }};"
						{% endif %}
						{{ block.shopify_attributes }}
					>
						{{ block.settings.text }}
						{{ block.settings.textarea }}
						{{ block.settings.page.content }}
						{{ block.settings.liquid }}
					</div>
				{%- when 'buttons' -%}
					<div
						id="{{ section.id }}-{{ block.id }}"
						class="page-width l-customm-content__buttons l-dynamic l-button__group flex flex-wrap items-center l-dynamic--content-mobile-{{ block.settings.text_alignment_mobile }} l-dynamic--content-desktop-{{ block.settings.text_alignment_desktop }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
						{% if settings.animations_reveal_on_scroll %}
							data-cascade
							style="--animation-order: {{ forloop.index }};"
						{% endif %}
						{{ block.shopify_attributes }}
					>
						{%- if block.settings.first_button_label != blank -%}
							<a
								{% if block.settings.first_button_link == blank %}
									role="link" aria-disabled="true"
								{% else %}
									href="{{ block.settings.first_button_link }}"
								{% endif %}
								class="l-button--dynamic l-button--dynamic-first button{% if block.settings.full_width_mobile %} l-button--mobile-full{% endif %}"
							>
								{%- capture icon -%}
                {%- if block.settings.first_icon -%}
                  {{
                    block.settings.first_icon
                    | image_url: width: block.settings.first_icon_width
                    | image_tag
                  }}
                {%- endif -%}
              {%- endcapture -%}
								{%- if block.settings.first_icon_position == 'icon_with_text' -%}
									{{ icon }}
								{%- endif -%}
								{{- block.settings.first_button_label | escape -}}
								{%- if block.settings.first_icon_position == 'text_with_icon' -%}
									{{ icon }}
								{%- endif -%}
							</a>
						{%- endif -%}
						{%- if block.settings.second_button_label != blank -%}
							<a
								{% if block.settings.second_button_link == blank %}
									role="link" aria-disabled="true"
								{% else %}
									href="{{ block.settings.second_button_link }}"
								{% endif %}
								class="l-button--dynamic l-button--dynamic-second button{% if block.settings.full_width_mobile %} l-button--mobile-full{% endif %}"
							>
								{{- block.settings.second_button_label | escape -}}
							</a>
						{%- endif -%}
					</div>
				{%- when 'icon' -%}
					<div
						id="{{ section.id }}-{{ block.id }}"
						class="page-width l-custom-content__icon l-dynamic flex l-dynamic--content-mobile-{{ block.settings.text_alignment_mobile }} l-dynamic--content-desktop-{{ block.settings.text_alignment_desktop }}{{ block.settings.content_alignment }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
						{% if settings.animations_reveal_on_scroll %}
							data-cascade
							style="--animation-order: {{ forloop.index }};"
						{% endif %}
						{{ block.shopify_attributes }}
					>
						<div class="l-dynamic__media w-full">
							{%- if block.settings.image != blank -%}
								{%- assign image_height = block.settings.icon_width | divided_by: block.settings.image.aspect_ratio -%}
								{{
									block.settings.image
									| image_url: width: block.settings.icon_width
									| image_tag: width: block.settings.icon_width, height: image_height, loading: 'lazy'
								}}
							{%- elsif block.settings.svg != blank -%}
								{{ block.settings.svg }}
							{%- else -%}
								{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
							{%- endif -%}
						</div>
					</div>
				{%- when 'image' -%}
					<div
						id="{{ section.id }}-{{ block.id }}"
						class="{% unless block.settings.show_image_full_width %} page-width{% endunless %} l-custom-content__image l-dynamic flex l-dynamic--content-mobile-{{ block.settings.text_alignment_mobile }} l-dynamic--content-desktop-{{ block.settings.text_alignment_desktop }}{{ block.settings.content_alignment }}{% unless block.settings.show_image_full_width %} page-width{% endunless %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
						{% if settings.animations_reveal_on_scroll %}
							data-cascade
							style="--animation-order: {{ forloop.index }};"
						{% endif %}
						{{ block.shopify_attributes }}
					>
						{%- if block.settings.image != blank -%}
							{% liquid
								# Set image width / height
								# ------------------------------------------------------------
								assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
								assign sizes = '100vw'
								assign image_width = 3840

								# Get max width size of image
								if block.settings.image.width > 3840
									assign image_width = block.settings.image.width
								endif

								# Render image with width restrictions
								unless block.settings.show_image_full_width
									# Setup image width
									assign image_width = block.settings.image.width

									if block.settings.image_width < image_width
										assign image_width = block.settings.image_width
									endif

									if block.settings.page_width < image_width
										assign image_width = block.settings.page_width
									endif
								endunless

								assign image_height = image_width | divided_by: block.settings.image.aspect_ratio

								# Set loading / fetchpriority properties
								# ------------------------------------------------------------
								assign fetch_priority = 'auto'
								assign loading = 'lazy'

								if section.index == 1
									assign loading = 'eager'
									assign fetch_priority = 'high'
								endif

								# Set-up class
								# ------------------------------------------------------------
								assign class = 'l-custom-content__image-img'

								if block.settings.show_image_full_width
									assign class = class | append: ' w-full'
								endif
							%}

							{%- unless block.settings.show_image_full_width -%}
								{%- capture sizes -%}
                  {%- if image_width >= 990 -%}
                    (min-width: 990px) {{ image_width }}px,
                  {%- endif -%}
                  {%- if image_width >= 750 and image_width < 990 -%}
                    (min-width: 750px) {{ image_width }}px,
                  {%- endif -%}
                  100vw
                {%- endcapture -%}
							{%- endunless -%}

							{% comment %} Render images {% endcomment %}
							<picture class="l-dynamic__media w-full global-media-settings">
								{%- if block.settings.image_mobile != blank -%}
									{{
										block.settings.image_mobile
										| image_url: width: image_width
										| image_tag: widths: widths, sizes: sizes
										| replace: '<img', '<source media="(max-width: 750px)"'
									}}
								{%- endif -%}
								{{
									block.settings.image
									| image_url: width: image_width
									| image_tag:
										width: image_width,
										height: image_height,
										widths: widths,
										sizes: sizes,
										class: class,
										alt: block.settings.image.alt,
										loading: loading,
										fetchpriority: fetch_priority
								}}
							</picture>
						{%- else -%}
							<div class="l-dynamic__media w-full">
								{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
							</div>
						{%- endif -%}
					</div>
			{%- endcase -%}
		{%- endfor -%}
	</div>
</div>

