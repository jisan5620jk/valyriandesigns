{{ 'lta-sections-featured-blog-v2.css' | asset_url | stylesheet_tag }}

{%- style -%}
	#shopify-section-{{ section.id }} {
	  --l-row-gap: {{ section.settings.row_gap }}px;
	  --l-column-gap: {{ section.settings.column_gap }}px;
	  padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
	  padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
	}

	@media screen and (min-width: 750px) {
	  #shopify-section-{{ section.id }} {
	    padding-top: {{ section.settings.padding_top }}px;
	    padding-bottom: {{ section.settings.padding_bottom }}px;
	  }
	}
{%- endstyle -%}

{%- liquid
	assign fetch_priority = 'auto'
	assign loading = 'lazy'

	if section.index == 1
		assign fetch_priority = 'high'
		assign loading = 'eager'
	endif
-%}

<div class="l-featured-blog-v2 gradient color-{{ section.settings.color_scheme }}">
	<div class="page-width">
		<div class="l-featured-blog-v2__grid flex items-start flex-wrap">
			{%- for block in section.blocks -%}
				{%- case block.type -%}
					{%- when 'article' -%}
						{%- assign article = block.settings.article -%}
						{%- assign article_image = article.metafields.custom.card_image.value | default: article.image -%}

						{%- if article != blank -%}
							<div
								class="l-featured-blog-v2__grid-item l-featured-blog-v2__grid-item--{{ block.settings.width }} l-featured-blog-v2-block-{{ forloop.index }}"
								{{ block.shopify_attributes }}
							>
								{%- if article_image != blank -%}
									<div
										class="l-featured-blog-v2__image relative{% if block.settings.richtext != blank %} l-featured-blog-v2__image--has-text{% endif %}"
										{% if section.settings.ratio != 'adapt' %}
											style="padding-bottom: {{ section.settings.ratio }};"
										{%- else -%}
											style="padding-bottom: {{ 1 | divided_by: article_image.aspect_ratio | times: 100 }}%;"
										{% endif %}
									>
										<a href="{{ article.url }}" class="l-featured-blog-v2__image-url"> </a>
										{%- assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840' -%}
										{%- assign image_height = article_image.width | divided_by: article_image.aspect_ratio -%}
										{%- case block.settings.width -%}
											{%- when '2-3' -%}
												{%- capture sizes -%}
                        (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | times: 2 | divided_by: 3 }}px,
                        (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2),
                        100vw
                      {%- endcapture -%}
											{%- when '1-2' -%}
												{%- capture sizes -%}
                          (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px,
                          (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2),
                          100vw
                        {%- endcapture -%}
											{%- when '1-3' -%}
												{%- capture sizes -%}
                        (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 3 }}px,
                        (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2),
                        100vw
                      {%- endcapture -%}
										{%- endcase -%}
										{{
											article_image
											| image_url: width: 1500
											| image_tag:
												width: article_image.width,
												height: image_height,
												sizes: sizes,
												widths: widths,
												fetchpriority: fetch_priority,
												loading: loading
										}}
									</div>
								{%- else -%}
									{{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg w-full' }}
								{%- endif -%}
								<a href="{{ article.url }}" class="l-featured-blog-v2__richtext">
									<span class="l-featured-blog-v2__article-title block">{{ article.title }}</span>
									<span class="l-featured-blog-v2__article-date block">
										{{- article.updated_at | date: '%B %d, %Y' -}}
									</span>
								</a>
							</div>
						{%- endif -%}
				{%- endcase -%}
			{%- endfor -%}
		</div>
	</div>
</div>

{% schema %}
{
	"name": "LTA - Featured blogs V2",
	"class": "section",
	"disabled_on": {
		"groups": ["header", "footer"]
	},
	"settings": [
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "t:sections.all.colors.label",
			"default": "scheme-1"
		},
		{
			"type": "header",
			"content": "Gap"
		},
		{
			"type": "range",
			"id": "row_gap",
			"min": 0,
			"max": 32,
			"step": 2,
			"unit": "px",
			"label": "Row gap",
			"default": 30
		},
		{
			"type": "range",
			"id": "column_gap",
			"min": 0,
			"max": 32,
			"step": 2,
			"unit": "px",
			"label": "Column gap",
			"default": 30
		},
		{
			"type": "select",
			"id": "ratio",
			"label": "Ratio",
			"default": "100%",
			"options": [
				{
					"value": "100%",
					"label": "Portraint"
				},
				{
					"value": "56.25%",
					"label": "Landscape"
				},
				{
					"value": "adapt",
					"label": "Adapt"
				}
			]
		},
		{
			"type": "header",
			"content": "t:sections.all.padding.section_padding_heading"
		},
		{
			"type": "range",
			"id": "padding_top",
			"min": 0,
			"max": 100,
			"step": 4,
			"unit": "px",
			"label": "t:sections.all.padding.padding_top",
			"default": 36
		},
		{
			"type": "range",
			"id": "padding_bottom",
			"min": 0,
			"max": 100,
			"step": 4,
			"unit": "px",
			"label": "t:sections.all.padding.padding_bottom",
			"default": 36
		}
	],
	"blocks": [
		{
			"name": "Article",
			"type": "article",
			"settings": [
				{
					"type": "select",
					"id": "width",
					"label": "Width",
					"default": "1-3",
					"options": [
						{
							"value": "1-3",
							"label": "1 / 3"
						},
						{
							"value": "2-3",
							"label": "2 / 3"
						},
						{
							"value": "1-2",
							"label": "1 - 2"
						}
					]
				},
				{
					"type": "article",
					"id": "article",
					"label": "Article"
				}
			]
		}
	],
	"presets": [
		{
			"name": "LTA - Featured blogs V2",
			"blocks": []
		}
	]
}
{% endschema %}
