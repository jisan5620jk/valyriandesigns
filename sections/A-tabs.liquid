{{ 'lta-components-tabs.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lta-sections-tabs.js' |  asset_url }}" defer="defer"></script>

{% style %}
	#shopify-section-{{ section.id }} {
	  --page-width: {% if section.settings.show_full_width %}100%{% else %}{{ section.settings.page_width }}px{% endif %};
	  --l-container-background: {{ section.settings.container_background }};
	  --l-tab-name-gap: {{ section.settings.tab_name_gap }}px;
	  --l-tab-header-content-gap: {{ section.settings.gap_header_content }}px;
	  --l-tab-radius: {{ section.settings.corder_radius }}px;
	  --l-tab-border-width: {{ section.settings.border_width }}px;
	  --l-tab-title-color: {{ section.settings.tab_title_color }};
	  --l-tab-title-bg: {{ section.settings.tab_title_bg }};
	  --l-tab-border-color: {{ section.settings.tab_border_color }};
	  --l-tab-title-active-color: {{ section.settings.tab_title_active_color }};
	  --l-tab-title-active-bg: {{ section.settings.tab_title_active_bg }};
	  --l-tab-border-active-color: {{ section.settings.tab_border_active_color }};
	  --l-tab-content-color: {{ section.settings.tab_content_color }};
	  --l-tab-content-link-color: {{ section.settings.tab_content_link_color }};
	  background-color: {{ section.settings.background_color }};
	  padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
	  padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
	}

	@media screen and (min-width: 750px) {
	  #shopify-section-{{ section.id }} {
	    padding-top: {{ section.settings.padding_top }}px;
	    padding-bottom: {{ section.settings.padding_bottom }}px;
	  }
	}
{% endstyle %}

<div class="l-tabs__container page-width">
	<l-tabs class="l-tabs l-tabs--{{ section.settings.container_layout }} l-tabs--{{ section.settings.tab_layout }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
		<div class="l-tabs__header l-tabs__header--{{ section.settings.tab_layout }} l-tabs__header--{{ section.settings.tab_name_style }} flex items-center">
			{%- for block in section.blocks -%}
				<button
					class="l-tabs__button l-tabs__button--{{ section.settings.tab_name_style }} {{ section.settings.tab_title_size }} flex items-center{% if section.settings.tab_name_direction == 'vertical' %} flex-col{% endif %}{% if forloop.first %} is-active{% endif %}"
					data-tab="{{ block.id }}"
					{{ block.shopify_attributes }}
				>
					{% liquid
						assign icon = block.settings.icon
						assign svg = block.settings.svg
						assign icon_width = block.settings.icon_width
						assign sizes = icon_width | append: 'px'
						assign icon_height = icon_width | divided_by: icon.aspect_ratio
					%}
					{%- if block.settings.icon != blank -%}
						<span style="--l-icon-width: {{ icon_width }}px;">
							{{-
								icon
								| image_url: width: icon_width
								| image_tag:
									loading: 'lazy',
									alt: icon.alt,
									sizes: sizes,
									class: 'motion-reduce',
									width: icon_width,
									height: icon_height
							-}}
						</span>
					{%- endif -%}
					{% if svg != blank %}
						<span style="--l-icon-width: {{ icon_width }}px;">
							{{ svg }}
						</span>
					{% endif %}
					{{ block.settings.title }}
				</button>
			{%- endfor -%}
		</div>
		<div class="l-tabs__contents">
			{%- for block in section.blocks -%}
				<div
					class="l-tabs__content overflow-hidden l-rte--{{ section.settings.tab_content_size }} l-tabs__content--{{ section.settings.anmiation }} rte{%- unless forloop -%} hidden{%- endunless -%}"
					data-content="{{ block.id }}"
					{{ block.shopify_attributes }}
				>
					{{ block.settings.row_content }}
					{{ block.settings.textarea }}
					{{ block.settings.page.content }}
					{{ block.settings.liquid }}
				</div>
			{%- endfor -%}
		</div>
	</l-tabs>
</div>

