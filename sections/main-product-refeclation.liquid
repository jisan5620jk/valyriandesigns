<script>
  document.addEventListener('DOMContentLoaded', () => {
    const popUpBtn = document.querySelector('#openPopupBtn');
    const inputs = document.querySelectorAll('.swatch-input__input');

    function updateActiveState() {
      // Check if any input with the value 'Corten Steel' is checked
      const isCortenSteelChecked = Array.from(inputs).some((input) => input.checked && input.value === 'Corten Steel');
      const isStainlessSteelChecked = Array.from(inputs).some((input) => input.checked && input.value === 'Stainless Steel');

      // Toggle the 'show' class on the button based on Corten Steel selection
      if (isCortenSteelChecked) {
        popUpBtn.classList.add('show');       
      }
      // Toggle the 'show' class on the button based on Stainless Steel selection
      else if (isStainlessSteelChecked) {
        popUpBtn.classList.add('show');        
      } 
      // Remove the 'show' class if neither is checked
      else {
        popUpBtn.classList.remove('show');
       
      }
    }

    // Initial update when the page loads
    updateActiveState();

    // Add event listeners to update the active state dynamically
    inputs.forEach((input) => {
      input.addEventListener('change', updateActiveState);
    });
  });
</script>