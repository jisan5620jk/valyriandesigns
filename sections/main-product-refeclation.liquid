                  assign delivery_day_min = block.settings.delivery_day_min | times: 24 | times: 60 | times: 60
                  assign delivery_day_min_text = 'now' | date: '%s' | plus: delivery_day_min | date: '%B %d' | prepend: '<strong>' | append: '</strong>'

                  assign delivery_day_max = block.settings.delivery_day_max | times: 24 | times: 60 | times: 60
                  assign delivery_day_max_text = 'now' | date: '%s' | plus: delivery_day_max | date: '%B %d' | prepend: '<strong>' | append: '</strong>'
                %}
                <div class="l-product-block-shipping">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewbox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="icon icon-tabler icons-tabler-outline icon-tabler-truck-delivery"
                  >
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M7 17m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"></path><path d="M17 17m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"></path><path d="M5 17h-2v-4m-1 -8h11v12m-4 0h6m4 0h2v-6h-8m0 -5h5l3 5"></path><path d="M3 9l4 0"></path>
                  </svg>
                  {{
                    block.settings.deliveried_text
                    | replace: '[date_min]', delivery_day_min_text
                    | replace: '[date_max]', delivery_day_max_text
                  }}
                </div>
            {%- endcase -%}
          {%- endfor -%}
          <a href="{{ product.url }}" class="link product__view-details animate-arrow">
            {{ 'products.product.view_full_details' | t }}
            {% render 'icon-arrow' %}
          </a>
        </product-info>
      </div>
    </div>

    {% render 'product-media-modal', variant_images: variant_images %}

    {% comment %}
      ------------------------------------------------------------
      [START]: POPUP MODAL
      ------------------------------------------------------------
    {% endcomment %}
    {% assign popups = section.blocks | where: 'type', 'popup' %}
    {%- for block in popups -%}
      <modal-dialog id="PopupModal-{{ block.id }}" class="product-popup-modal" {{ block.shopify_attributes }}>
        <div
          role="dialog"
          aria-modal="true"
          class="product-popup-modal__content{% if block.settings.video != blank %} product-popup-modal__content--video{% endif %}"
          tabindex="-1"
        >
          <button
            id="ModalClose-{{ block.id }}"
            type="button"
            class="product-popup-modal__toggle"
            aria-label="{{ 'accessibility.close' | t }}"
          >
            {% render 'icon-close' %}
          </button>
          {%- if block.settings.page.content != blank -%}
            <div class="product-popup-modal__content-info">
              {{ block.settings.page.content }}
            </div>
          {%- endif -%}
        </div>
      </modal-dialog>
    {%- endfor -%}

    {% comment %}
      ------------------------------------------------------------
      [START]: POPUP VIDEO MODAL
      ------------------------------------------------------------
    {% endcomment %}
    {% assign popup_videos = section.blocks | where: 'type', 'popup_videos' %}
    {%- if popup_videos.size -%}
      {{ 'video-section.css' | asset_url | stylesheet_tag }}
      {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
    {%- endif -%}
    {%- for block in popup_videos -%}
      {%- for index in (1..2) -%}
        <modal-dialog
          id="PopupModal-{{ block.id }}-{{ forloop.index }}"
          class="product-popup-modal"
          {{ block.shopify_attributes }}
        >
          <div
            role="dialog"
            aria-modal="true"
            class="product-popup-modal__content product-popup-modal__content--video"
            tabindex="-1"
          >
            <button
              id="ModalClose-{{ block.id }}-{{ forloop.index }}"
              type="button"
              class="product-popup-modal__toggle"
              aria-label="{{ 'accessibility.close' | t }}"
            >
              {% render 'icon-close' %}
            </button>
            {%- liquid
              # Setup settings name
              assign video_setting = 'video_' | append: index
              assign video_url_setting = 'video_url_' | append: index
              assign video_desc_setting = 'description_' | append: index

              # Settings value
              assign video_id = block.settings[video_setting].id | default: block.settings[video_url_setting].id
              assign video_alt = block.settings[video_setting].alt | default: block.settings[video_desc_setting]
              assign alt = 'sections.video.load_video' | t: description: video_alt | escape
              assign poster = block.settings[video_setting].preview_image | default: block.settings.cover_image

              if block.settings.video != null
                assign ratio_diff = block.settings[video_setting].aspect_ratio | minus: poster.aspect_ratio | abs
                if ratio_diff < 0.01 and ratio_diff > 0
                  assign fix_ratio = true
                endif
              endif
            -%}
            {%- capture sizes -%}
              (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 }}px, (min-width: 750px)
              calc(100vw - 10rem), 100vw
            {%- endcapture -%}
            <deferred-media
              class="video-section__media deferred-media gradient global-media-settings{% if block.settings.full_width %} global-media-settings--full-width{% endif %}{% if fix_ratio %} media-fit-cover{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              data-media-id="{{ video_id }}"
              data-autoplay="sound"
              {% if poster != null %}
                style="--ratio-percent-mobile: 100%;--ratio-percent: {{ 1 | divided_by: poster.aspect_ratio | times: 100 }}%;"
              {% endif %}
            >
              <button
                id="Deferred-Poster-Modal-{{ video_id }}"
                class="video-section__poster media deferred-media__poster media--landscape"
                type="button"
                aria-label="{{ alt }}"
              >
                {%- if poster != null -%}
                  {{
                    poster
                    | image_url: width: 3840
                    | image_tag: sizes: sizes, widths: '375, 750, 1100, 1500, 1780, 2000, 3000, 3840', alt: alt
                  }}
                {%- else -%}
                  {{ 'hero-apparel-3' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
                {%- endif -%}
                <span class="deferred-media__poster-button motion-reduce">
                  {%- render 'icon-play' -%}
                </span>
              </button>
              <template>
                {%- if block.settings[video_setting] == null and block.settings[video_url_setting] != null -%}
                  {%- if block.settings.video_url.type == 'youtube' -%}
                    <iframe
                      src="https://www.youtube.com/embed/{{ video_id }}?enablejsapi=1&autoplay=1"
                      class="js-youtube"
                      allow="autoplay; encrypted-media"
                      allowfullscreen
                      title="{{ block.settings[video_desc_setting] | escape }}"
                    ></iframe>
                  {%- else -%}
                    <iframe
                      src="https://player.vimeo.com/video/{{ video_id }}?autoplay=1"
                      class="js-vimeo"
                      allow="autoplay; encrypted-media"
                      allowfullscreen
                      title="{{ block.settings[video_desc_setting] | escape }}"
                    ></iframe>
                  {%- endif -%}
                {%- else -%}
                  {{
                    block.settings[video_setting]
                    | video_tag: image_size: '1100x', autoplay: false, loop: true, controls: true, muted: false
                  }}
                {%- endif -%}
              </template>
            </deferred-media>
          </div>
        </modal-dialog>
      {%- endfor -%}
    {%- endfor -%}
    {% comment %}
      ------------------------------------------------------------
      [END]: POPUP VIDEO
      ------------------------------------------------------------
    {% endcomment %}

    {%- if product.media.size > 0 -%}
      <script src="{{ 'lta-components-product-modal.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'lta-components-media-gallery.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- if first_3d_model -%}
      <script type="application/json" id="ProductJSON-{{ product.id }}">
        {{ product.media | where: 'media_type', 'model' | json }}
      </script>
      <script src="{{ 'lta-components-product-model.js' | asset_url }}" defer></script>
    {%- endif -%}

    {%- liquid
      if product.selected_or_first_available_variant.featured_media
        assign seo_media = product.selected_or_first_available_variant.featured_media
      else
        assign seo_media = product.featured_media
      endif
    -%}

    <script type="application/ld+json">
      {
        "@context": "http://schema.org/",
        "@type": "Product",
        "name": {{ product.title | json }},
        "url": {{ request.origin | append: product.url | json }},
        {% if seo_media -%}
          "image": [
            {{ seo_media | image_url: width: 1920 | prepend: "https:" | json }}
          ],
        {%- endif %}
        "description": {{ product.description | strip_html | json }},
        {% if product.selected_or_first_available_variant.sku != blank -%}
          "sku": {{ product.selected_or_first_available_variant.sku | json }},
        {%- endif %}
        "brand": {
          "@type": "Brand",
          "name": {{ product.vendor | json }}
        },
        "offers": [
          {%- for variant in product.variants -%}
            {
              "@type" : "Offer",
              {%- if variant.sku != blank -%}
                "sku": {{ variant.sku | json }},
              {%- endif -%}
              {%- if variant.barcode.size == 12 -%}
                "gtin12": {{ variant.barcode }},
              {%- endif -%}
              {%- if variant.barcode.size == 13 -%}
                "gtin13": {{ variant.barcode }},
              {%- endif -%}
              {%- if variant.barcode.size == 14 -%}
                "gtin14": {{ variant.barcode }},
              {%- endif -%}
              "availability" : "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
              "price" : {{ variant.price | divided_by: 100.00 | json }},
              "priceCurrency" : {{ cart.currency.iso_code | json }},
              "url" : {{ request.origin | append: variant.url | json }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>
  </div>
</section>

<script>
  // Get elements
  const openPopupBtn = document.getElementById('openPopupBtn');
  const closePopupBtn = document.getElementById('closePopupBtn');
  const popup = document.getElementById('popup');
  const overlay = document.getElementById('overlay');

  // Open the popup
  openPopupBtn.addEventListener('click', () => {
    popup.style.display = 'block';
    overlay.style.display = 'block';
    setTimeout(() => {
      popup.classList.add('show');
      overlay.classList.add('show');
    }, 10); // Slight delay to trigger the transition
  });

  // Close the popup
  closePopupBtn.addEventListener('click', () => {
    popup.classList.remove('show');
    overlay.classList.remove('show');
    setTimeout(() => {
      popup.style.display = 'none';
      overlay.style.display = 'none';
    }, 300); // Match the transition duration
  });

  // Close the popup when clicking outside of it
  overlay.addEventListener('click', () => {
    popup.classList.remove('show');
    overlay.classList.remove('show');
    setTimeout(() => {
      popup.style.display = 'none';
      overlay.style.display = 'none';
    }, 300); // Match the transition duration
  });
</script>

<script>
  document.getElementById('openPopupBtn').addEventListener('click', function () {
    const thumbnails = document.querySelectorAll('.thumbnail-list__item:first-child button.is-active');
    const videoContainers = document.querySelectorAll('.video-container');
    const videos = document.querySelectorAll('.product-video');
    const closeButtons = document.querySelectorAll('#closePopupBtn, #overlay');

    thumbnails.forEach((activeButton) => {
      const image = activeButton.querySelector('img');
      if (image) {
        const altText = image.alt; // Get alt text of active thumbnail image
        console.log(altText);

        // Iterate through all videos
        videos.forEach((video, index) => {
          const dataID = video.getAttribute('data-id');
          console.log(dataID); // Corrected variable name
          const container = videoContainers[index];

          if (dataID === altText) {
            // Show and play the matching video
            container.classList.add('active');
            container.style.display = 'block';
            video.muted = false;
            video.play();
            video.load();
          } else {
            // Hide and pause non-matching videos
            container.classList.remove('active');
            container.style.display = 'none';
            video.pause();
            video.muted = true;
          }
        });
      }
    });

    // Add close button functionality
    closeButtons.forEach((button) => {
      button.addEventListener('click', () => {
        videoContainers.forEach((container) => {
          container.style.display = 'none';
          container.classList.remove('active');
        });
        videos.forEach((video) => {
          video.pause();
          video.muted = true;
        });
      });
    });
  });
</script>

<script>
  const videoContainers = document.querySelectorAll('.video-container');
  const videos = document.querySelectorAll('.product-video'); // Select all product-video elements

  videoContainers.forEach((container, index) => {
    const pauseOtherVideos = () => {
      videos.forEach((video, videoIndex) => {
        if (videoIndex !== index) {
          video.pause(); // Pause all other videos
          video.muted = true;
          videoContainers[videoIndex].classList.add('paused'); // Add 'paused' class to other video containers
        }
      });
    };

    container.addEventListener('click', () => {
      if (videos[index].paused) {
        pauseOtherVideos(); // Pause other videos before playing this one
        videos[index].play();
        videos[index].muted = false; // Sound on when playing
        container.classList.remove('paused'); // Remove 'paused' class when playing
      } else {
        videos[index].pause();
        videos[index].muted = true; // Mute on when paused
        container.classList.add('paused'); // Add 'paused' class when paused
      }
    });
  });
</script>



