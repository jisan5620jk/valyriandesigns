{% style %}
	#shopify-section-{{ section.id }} {
	  --page-width: {% if section.settings.show_full_width %}100%{% else %}{{ section.settings.page_width }}px{% endif %};
	  --l-text-color: {{ section.settings.text_color }};
	  padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
	  padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
	}

	@media screen and (min-width: 750px) {
	  #shopify-section-{{ section.id }} {
	    padding-top: {{ section.settings.padding_top }}px;
	    padding-bottom: {{ section.settings.padding_bottom }}px;
	  }
	}
{% endstyle %}

{%- if section.settings.show_full_width -%}
	{% render 'A-breadcrumbs' %}
{%- else -%}
	<div class="page-width">
		{% render 'A-breadcrumbs' %}
	</div>
{%- endif -%}

{% schema %}
{
	"name": "LTA - Breadcrumbs",
	"settings": [
		{
			"type": "header",
			"content": "Layout"
		},
		{
			"type": "range",
			"id": "page_width",
			"min": 600,
			"max": 1600,
			"step": 100,
			"default": 1200,
			"unit": "px",
			"label": "t:settings_schema.layout.settings.page_width.label"
		},
		{
			"type": "checkbox",
			"id": "show_full_width",
			"label": "Show full width",
			"default": false
		},
		{
			"type": "header",
			"content": "Colors"
		},
		{
			"type": "color",
			"id": "text_color",
			"label": "Color",
			"default": "#A8A8A8"
		},
		{
			"type": "header",
			"content": "t:sections.all.padding.section_padding_heading"
		},
		{
			"type": "range",
			"id": "padding_top",
			"min": 0,
			"max": 100,
			"step": 4,
			"unit": "px",
			"label": "t:sections.all.padding.padding_top",
			"default": 36
		},
		{
			"type": "range",
			"id": "padding_bottom",
			"min": 0,
			"max": 100,
			"step": 4,
			"unit": "px",
			"label": "t:sections.all.padding.padding_bottom",
			"default": 36
		}
	],
	"presets": [
		{
			"name": "LTA - Breadcrumbs",
			"category": "Carousel"
		}
	]
}
{% endschema %}
